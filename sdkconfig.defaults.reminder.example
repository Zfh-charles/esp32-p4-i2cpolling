# 轮询提醒功能参考配置（复制到 menuconfig 或合并进本地 sdkconfig）
# 勿直接提交含真实 ngrok 域名的 sdkconfig

CONFIG_BOARD_TYPE_EP_CHAT_P4_ML307=y
CONFIG_USE_REMINDER_POLL=y

# 替换 YOUR_PUBLIC_HOST 为 ngrok 域名或 VPS 域名
CONFIG_REMINDER_POLL_DEFAULT_URL="http://114.245.176.144:8443/v1/devices/{device_id}/reminders/pending"
CONFIG_REMINDER_POLL_DEFAULT_ACK_URL=""
CONFIG_REMINDER_POLL_INTERVAL_SEC=300
CONFIG_REMINDER_ALARM_REPEAT_SEC=10
CONFIG_REMINDER_ALARM_DURATION_SEC=30
CONFIG_REMINDER_WAKE_PHRASE="查提醒"
CONFIG_REMINDER_DIAG_AUTO_HEAL=y
CONFIG_REMINDER_BOOT_DEFER_SEC=5

# MQTT 唤醒：push 后设备立即 GET；轮询间隔作兜底
CONFIG_REMINDER_MQTT_WAKE=y
CONFIG_REMINDER_MQTT_WAKE_DEFAULT_BROKER="114.245.176.144:8883"
CONFIG_REMINDER_MQTT_WAKE_DEFAULT_TOPIC="v1/notify/{mac_clean}"
CONFIG_REMINDER_MQTT_WAKE_DEFAULT_USERNAME="esp32_{mac_clean}"
CONFIG_REMINDER_MQTT_WAKE_DEFAULT_CLIENT_ID="esp32-{mac_clean}"
# CONFIG_REMINDER_MQTT_WAKE_DERIVE_PASSWORD is not set
# Put CONFIG_REMINDER_MQTT_WAKE_SECRET_SALT in a private local defaults file.
# CONFIG_REMINDER_MQTT_TLS_INSECURE is not set

# COM4 hardware integration
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
